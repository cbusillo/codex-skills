#!/bin/sh
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
git_bin=${GIT_COMMIT_AS_BOT_GIT:-git}
identity_helper=${GIT_COMMIT_AS_BOT_IDENTITY_HELPER:-$script_dir/github_identity.py}
python_command=${GIT_COMMIT_AS_BOT_PYTHON:-}

. "$script_dir/github-task-worktree.sh"
[ "${1:-}" = --worktree ] || require_task_worktree ""
require_task_worktree "${2:-}"
shift 2

# A caller's required automation auth holds even when local.env says otherwise,
# and only the caller can opt in to committing as their own GitHub user.
caller_require_automation_auth=${GH_WITH_ENV_TOKEN_REQUIRE_AUTOMATION_AUTH:-}
caller_own_user=${GH_WITH_ENV_TOKEN_OWN_USER:-}

# Use the first local.env that exists under CODE_HOME, CODEX_HOME, then
# ~/.code. An explicit CODEX_SKILLS_ENV_FILE always wins, even when missing, so
# tests and isolated callers can load nothing.
if [ -n "${CODEX_SKILLS_ENV_FILE:-}" ]; then
	env_file=$CODEX_SKILLS_ENV_FILE
else
	env_file=
	for env_home in "${CODE_HOME:-}" "${CODEX_HOME:-}" "${HOME:+$HOME/.code}"; do
		if [ -n "$env_home" ] && [ -f "$env_home/local.env" ]; then
			env_file=$env_home/local.env
			break
		fi
	done
fi

if [ -f "$env_file" ]; then
	identity_values=$(
		# Load private configuration in a subshell so unrelated values and
		# credentials never reach git commit or its hooks.
		# shellcheck disable=SC1090
		. "$env_file" >/dev/null
		printf '%s\n%s\n%s\n%s\n%s\n' \
			"${GIT_COMMIT_AS_BOT_NAME:-${CODEX_AUTOMATION_LOGIN:-}}" \
			"${GIT_COMMIT_AS_BOT_EMAIL:-${CODEX_AUTOMATION_EMAIL:-}}" \
			"${GITHUB_APP_ID:-${GITHUB_CLIENT_APP_OWNERS:-}}" \
			"${GH_WITH_ENV_TOKEN_REQUIRE_AUTOMATION_AUTH:-}" \
			"${GITHUB_APP_ID:+app}"
	)
	bot_name=$(printf '%s\n' "$identity_values" | sed -n '1p')
	bot_email=$(printf '%s\n' "$identity_values" | sed -n '2p')
	app_configured=$(printf '%s\n' "$identity_values" | sed -n '3p')
	require_automation_auth=$(printf '%s\n' "$identity_values" | sed -n '4p')
	primary_app_configured=$(printf '%s\n' "$identity_values" | sed -n '5p')
else
	bot_name=${GIT_COMMIT_AS_BOT_NAME:-${CODEX_AUTOMATION_LOGIN:-}}
	bot_email=${GIT_COMMIT_AS_BOT_EMAIL:-${CODEX_AUTOMATION_EMAIL:-}}
	app_configured=${GITHUB_APP_ID:-${GITHUB_CLIENT_APP_OWNERS:-}}
	require_automation_auth=${GH_WITH_ENV_TOKEN_REQUIRE_AUTOMATION_AUTH:-}
	primary_app_configured=${GITHUB_APP_ID:+app}
fi

if [ "$#" -eq 0 ]; then
	echo "usage: git-commit-as-bot --worktree /absolute/task/path [--repo OWNER/REPO] [--git-command commit|merge|pull|rebase|cherry-pick|revert|am] [--refresh-required REQUIREMENT] <git args...>" >&2
	exit 2
fi

# Keep existing commit arguments compatible; the explicit mode supplies the
# same identity selection for other commands that can create commits.
git_command=commit
target_repository=
refresh_required=
while [ "$#" -gt 0 ]; do
	case "$1" in
	--repo)
		[ "$#" -ge 2 ] || { echo "error: --repo needs OWNER/REPO" >&2; exit 2; }
		[ -z "$target_repository" ] || { echo "error: --repo may be supplied only once" >&2; exit 2; }
		target_repository=$2
		case "$target_repository" in
		*/*) target_owner=${target_repository%%/*}; target_name=${target_repository#*/} ;;
		*) target_owner=; target_name= ;;
		esac
		case "$target_owner/$target_name" in
		/* | */ | *[!a-zA-Z0-9_./-]* | ./* | ../* | */. | */.. | */*/*)
			echo "error: --repo requires a GitHub OWNER/REPO pair" >&2; exit 2 ;;
		esac
		shift 2
		;;
	--git-command)
		[ "$#" -ge 2 ] || { echo "error: --git-command needs a command" >&2; exit 2; }
		git_command=$2
		shift 2
		case "$git_command" in
		commit | merge | pull | rebase | cherry-pick | revert | am) ;;
		*) echo "error: unsupported commit-creating Git command: $git_command" >&2; exit 2 ;;
		esac
		;;
	--refresh-required)
		[ "$#" -ge 2 ] && [ -n "$2" ] || { echo "error: --refresh-required needs the check or rule that requires a fresh base" >&2; exit 2; }
		refresh_required=$2
		shift 2
		;;
	*) break ;;
	esac
done
[ "$#" -gt 0 ] || { echo "error: Git arguments are required" >&2; exit 2; }

# The merge train owns base freshness, so a task branch takes the default
# branch only for a real conflict or a named requirement (repo-workflow.md
# Merge Readiness). Any other refresh only reruns the PR's CI.
refuse_refresh() {
	echo "error: $1; the merge train owns freshness, so this refresh would only rerun CI" >&2
	echo "hint: merge the base only for a real conflict, or name the check or rule that requires it with --refresh-required \"<requirement>\" (repo-workflow.md Merge Readiness)" >&2
	exit 1
}

# Refuse when the commit brings the default branch into the subject branch
# without conflicts.
check_refresh_commit() {
	commit=$("$git_bin" rev-parse -q --verify "$1^{commit}" 2>/dev/null) || return 0
	target=$("$git_bin" rev-parse -q --verify "$subject_ref^{commit}" 2>/dev/null) || return 0
	"$git_bin" merge-base --is-ancestor "$commit" "$default_ref" 2>/dev/null || return 0
	! "$git_bin" merge-base --is-ancestor "$commit" "$target" 2>/dev/null || return 0
	# merge-tree exits 1 for a conflict; any other failure leaves the merge to Git.
	merge_tree_status=0
	"$git_bin" merge-tree --write-tree "$target" "$commit" >/dev/null 2>&1 || merge_tree_status=$?
	[ "$merge_tree_status" -ne 0 ] || refuse_refresh "$1 brings $default_branch into $subject without conflicts"
}

refuse_pull() {
	refuse_refresh "pulling $default_branch into $subject cannot be checked for a conflict first; fetch, then use --git-command merge origin/$default_branch"
}

check_base_refresh() {
	[ -z "$refresh_required" ] || return 0
	# Options that take a separate value, per command; any other option is a
	# flag or carries its value after "=".
	case "$git_command" in
	merge) value_options=' -m -F --file -s -X --strategy --strategy-option --cleanup --into-name ' ;;
	pull) value_options=' -s -X --strategy --strategy-option --depth --deepen --shallow-since --shallow-exclude -o --server-option --upload-pack -j --jobs --refmap ' ;;
	rebase) value_options=' -s -X --strategy --strategy-option -x --exec --onto ' ;;
	*) return 0 ;;
	esac
	# origin/HEAD is optional, for example after remote add and fetch.
	if default_ref=$("$git_bin" symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null); then :
	elif "$git_bin" rev-parse -q --verify refs/remotes/origin/main >/dev/null; then default_ref=refs/remotes/origin/main
	elif "$git_bin" rev-parse -q --verify refs/remotes/origin/master >/dev/null; then default_ref=refs/remotes/origin/master
	else return 0
	fi
	default_branch=${default_ref#refs/remotes/origin/}
	takes_value=
	operands=0
	onto=
	upstream_operand=
	branch_operand=
	pull_refspec=
	for arg in "$@"; do
		if [ -n "$takes_value" ]; then
			[ "$takes_value" != --onto ] || onto=$arg
			takes_value=
			continue
		fi
		case "$arg" in
		--continue | --abort | --quit | --skip | --edit-todo | --show-current-patch) return 0 ;;
		--root | --keep-base) [ "$git_command" != rebase ] || return 0 ;;
		--onto=*) onto=${arg#--onto=}; continue ;;
		esac
		case "$value_options" in *" $arg "*) takes_value=$arg; continue ;; esac
		case "$arg" in -*) continue ;; esac
		operands=$((operands + 1))
		case "$git_command:$operands" in
		merge:*) upstream_operand="$upstream_operand $arg" ;;
		rebase:1) upstream_operand=$arg ;;
		rebase:2) branch_operand=$arg ;;
		pull:1) ;;
		pull:*)
			# A fetched refspec cannot be checked for conflicts before it merges.
			case "${arg#+}" in
			"$default_branch" | "$default_branch":* | "refs/heads/$default_branch" | "refs/heads/$default_branch":*) pull_refspec=1 ;;
			esac
			;;
		esac
	done
	# A rebase may name the branch it rewrites; everything else changes HEAD.
	if [ -n "$branch_operand" ]; then
		subject=$branch_operand
		subject_ref=$branch_operand
	else
		subject=$("$git_bin" symbolic-ref -q --short HEAD 2>/dev/null) || return 0
		subject_ref=HEAD
	fi
	[ "$subject" != "$default_branch" ] || return 0
	# Without an operand, Git takes the branch's upstream, which is the base
	# until a task branch's first push.
	upstream='@{upstream}'
	case "$git_command" in
	merge)
		[ -n "$upstream_operand" ] || upstream_operand=$upstream
		for commit_operand in $upstream_operand; do check_refresh_commit "$commit_operand"; done
		;;
	rebase) check_refresh_commit "${onto:-${upstream_operand:-$upstream}}" ;;
	pull)
		[ -z "$pull_refspec" ] || refuse_pull
		if [ "$operands" -le 1 ] &&
			[ "$("$git_bin" rev-parse -q --symbolic-full-name "$upstream" 2>/dev/null)" = "$default_ref" ]; then
			refuse_pull
		fi
		;;
	esac
}
check_base_refresh "$@"

# In a repository the App's registering account does not own and the GitHub
# App is not installed on, a contributor's agent works as the person when the
# caller opts in: the commit keeps their own git identity, as git-push-as-bot
# and gh-with-env-token do for the push and the pull request.
commit_repository() {
	if [ -n "$target_repository" ]; then
		printf '%s\n' "$target_repository"
		return
	fi
	origin_url=$("$git_bin" remote get-url origin 2>/dev/null) || return 1
	case "$origin_url" in
	git@github.com:*) repo=${origin_url#git@github.com:} ;;
	ssh://git@github.com/*) repo=${origin_url#ssh://git@github.com/} ;;
	https://github.com/*) repo=${origin_url#https://github.com/} ;;
	https://*@github.com/*) repo=${origin_url#https://*@github.com/} ;;
	*) return 1 ;;
	esac
	printf '%s\n' "${repo%.git}"
}

if [ -n "$app_configured" ] && [ -z "$primary_app_configured" ] && repo=$(commit_repository); then
	if [ -n "$python_command" ]; then
		selected_prefix=$($python_command "$identity_helper" app-prefix --repo "$repo")
	elif command -v uv >/dev/null 2>&1; then
		selected_prefix=$("$script_dir/github-python" "$identity_helper" app-prefix --repo "$repo")
	else
		echo "error: git-commit-as-bot requires uv or GIT_COMMIT_AS_BOT_PYTHON to choose the identity for $repo" >&2
		exit 127
	fi
	if [ "$selected_prefix" != GITHUB_CLIENT_APP ]; then app_configured=; fi
fi

if [ -n "$app_configured" ] && repo=$(commit_repository); then
	identity_status=0
	identity_error_file=$(mktemp "${TMPDIR:-/tmp}/git-commit-as-bot.XXXXXX")
	if [ -n "$python_command" ]; then
		$python_command "$identity_helper" app-auth --repo "$repo" --require-installation >/dev/null 2>"$identity_error_file" || identity_status=$?
	elif command -v uv >/dev/null 2>&1; then
		"$script_dir/github-python" "$identity_helper" app-auth --repo "$repo" --require-installation >/dev/null 2>"$identity_error_file" || identity_status=$?
	else
		rm -f "$identity_error_file"
		echo "error: git-commit-as-bot requires uv or GIT_COMMIT_AS_BOT_PYTHON to choose the identity for $repo" >&2
		exit 127
	fi
	identity_error=$(cat "$identity_error_file")
	rm -f "$identity_error_file"
	# github_identity: 0 the App, 4 the registering account's repository
	# without it (the push refuses later), 3 the person's own identity.
	case $identity_status in
	0 | 4) ;;
	3)
		case "$caller_require_automation_auth:$require_automation_auth" in
		1:* | true:* | TRUE:* | yes:* | YES:* | *:1 | *:true | *:TRUE | *:yes | *:YES)
			echo "error: $repo is not the automation's repository and automation authentication is required; refusing to commit as your own GitHub user" >&2
			exit 1
			;;
		esac
		case "$caller_own_user" in
		1 | true | TRUE | yes | YES) ;;
		*)
			echo "error: the GitHub App is not installed on $repo and another account owns it; committing there as your own GitHub user needs your Director's approval and GH_WITH_ENV_TOKEN_OWN_USER=1 on this command" >&2
			exit 1
			;;
		esac
		echo "notice: acting as your own GitHub user on $repo; committing with your git identity" >&2
		exec env -u CODEX_GITHUB_TOKEN -u GH_TOKEN -u GITHUB_TOKEN "$git_bin" "$git_command" "$@"
		;;
	*)
		printf '%s\n' "$identity_error" >&2
		echo "error: could not tell which identity commits to $repo; refusing to commit" >&2
		exit 1
		;;
	esac
fi

if [ -z "$bot_name" ] || [ -z "$bot_email" ]; then
	echo "error: git-commit-as-bot requires configured commit name and email" >&2
	echo "hint: set CODEX_AUTOMATION_LOGIN and CODEX_AUTOMATION_EMAIL in local.env" >&2
	exit 1
fi

GIT_AUTHOR_NAME=$bot_name \
	GIT_AUTHOR_EMAIL=$bot_email \
	GIT_COMMITTER_NAME=$bot_name \
	GIT_COMMITTER_EMAIL=$bot_email \
	env -u CODEX_GITHUB_TOKEN -u GH_TOKEN -u GITHUB_TOKEN \
	"$git_bin" "$git_command" "$@"
