#!/bin/sh
# Preserve project isolation while honoring the native user cache route.
set -eu
uv_user_home=${HOME:-$(cd ~ && pwd)}
uv_config="${XDG_CONFIG_HOME:-$uv_user_home/.config}/uv/uv.toml"
if [ -f "$uv_config" ]; then
    cache_dir=$(uv --no-config --config-file "$uv_config" cache dir)
else
    cache_dir=$(uv --no-config cache dir)
fi
UV_CACHE_DIR="$cache_dir" exec uv run --no-project --no-config --python 3.12 python "$@"
