#!/bin/sh
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
git_bin=${GIT_PUSH_AS_BOT_GIT:-git}
identity_helper=${GIT_PUSH_AS_BOT_IDENTITY_HELPER:-$script_dir/github_identity.py}
python_command=${GIT_PUSH_AS_BOT_PYTHON:-}

if [ -n "${CODEX_SKILLS_ENV_FILE:-}" ]; then
	env_file=$CODEX_SKILLS_ENV_FILE
elif [ -n "${CODE_HOME:-}" ]; then
	env_file=$CODE_HOME/local.env
elif [ -n "${CODEX_HOME:-}" ]; then
	env_file=$CODEX_HOME/local.env
elif [ -n "${HOME:-}" ]; then
	env_file=$HOME/.code/local.env
else
	env_file=
fi

if [ -f "$env_file" ]; then
	set -a
	# shellcheck disable=SC1090
	. "$env_file"
	set +a
fi

# Select credentials the way the GitHub CLI wrapper does, so pushes and API writes
# run as the same automation identity: a configured GitHub App comes first.
app_variable_count=0
for app_variable in GITHUB_APP_ID GITHUB_APP_INSTALLATION_ID GITHUB_APP_PRIVATE_KEY_PATH; do
	eval "app_variable_value=\${$app_variable:-}"
	if [ -n "$app_variable_value" ]; then
		app_variable_count=$((app_variable_count + 1))
	fi
done

if [ "$app_variable_count" -gt 0 ]; then
	if [ "$app_variable_count" -ne 3 ]; then
		echo "error: incomplete GitHub App configuration; set GITHUB_APP_ID, GITHUB_APP_INSTALLATION_ID, and GITHUB_APP_PRIVATE_KEY_PATH" >&2
		exit 1
	fi
	if [ -n "$python_command" ]; then
		app_auth_output=$($python_command "$identity_helper" app-auth) || exit 1
	elif command -v uv >/dev/null 2>&1; then
		app_auth_output=$(uv run --no-project --no-config --python 3.12 "$identity_helper" app-auth) || exit 1
	else
		echo "error: git-push-as-bot requires uv or GIT_PUSH_AS_BOT_PYTHON for GitHub App authentication" >&2
		exit 127
	fi
	app_login=$(printf '%s\n' "$app_auth_output" | sed -n '1p')
	GIT_PUSH_AS_BOT_TOKEN=$(printf '%s\n' "$app_auth_output" | sed -n '2p')
	if [ -z "$app_login" ] || [ -z "$GIT_PUSH_AS_BOT_TOKEN" ] || [ "$(printf '%s\n' "$app_auth_output" | sed -n '3p')" != "" ]; then
		echo "error: GitHub App authentication helper returned an invalid response; refusing to push" >&2
		exit 1
	fi
	expected_login=${GH_WITH_ENV_TOKEN_EXPECTED_LOGIN:-${CODEX_AUTOMATION_LOGIN:-}}
	if [ -n "$expected_login" ] &&
		[ "$(printf '%s' "$app_login" | tr '[:upper:]' '[:lower:]')" != "$(printf '%s' "$expected_login" | tr '[:upper:]' '[:lower:]')" ]; then
		echo "error: push would run as '$app_login', expected '$expected_login'" >&2
		echo "hint: configure CODEX_AUTOMATION_LOGIN for the GitHub App bot identity" >&2
		exit 1
	fi
elif [ -n "${CODEX_GITHUB_TOKEN:-}" ]; then
	GIT_PUSH_AS_BOT_TOKEN=$CODEX_GITHUB_TOKEN
elif [ -n "${GH_TOKEN:-}" ]; then
	GIT_PUSH_AS_BOT_TOKEN=$GH_TOKEN
elif [ -n "${GITHUB_TOKEN:-}" ]; then
	GIT_PUSH_AS_BOT_TOKEN=$GITHUB_TOKEN
else
	echo "error: no bot GitHub token found; refusing to push as active local git user" >&2
	echo "hint: configure a GitHub App or CODEX_GITHUB_TOKEN for the automation role" >&2
	exit 1
fi

origin_url=$("$git_bin" remote get-url origin)
case "$origin_url" in
git@github.com:*)
	repo=${origin_url#git@github.com:}
	;;
ssh://git@github.com/*)
	repo=${origin_url#ssh://git@github.com/}
	;;
https://github.com/*)
	repo=${origin_url#https://github.com/}
	;;
https://*@github.com/*)
	repo=${origin_url#https://*@github.com/}
	;;
*)
	echo "error: origin remote is not a github.com URL supported by git-push-as-bot: $origin_url" >&2
	exit 1
	;;
esac

repo=${repo%.git}
https_url="https://github.com/$repo.git"
askpass=$(mktemp "${TMPDIR:-/tmp}/git-push-as-bot.XXXXXX")

cleanup() {
	"$git_bin" remote set-url origin "$origin_url" >/dev/null 2>&1 || true
	rm -f "$askpass"
}
trap cleanup EXIT INT HUP TERM

cat >"$askpass" <<'EOF'
#!/bin/sh
case "$1" in
*Username*) printf '%s\n' x-access-token ;;
*) printf '%s\n' "$GIT_PUSH_AS_BOT_TOKEN" ;;
esac
EOF
chmod 700 "$askpass"

"$git_bin" remote set-url origin "$https_url"
GIT_ASKPASS=$askpass \
	GIT_TERMINAL_PROMPT=0 \
	GIT_PUSH_AS_BOT_TOKEN=$GIT_PUSH_AS_BOT_TOKEN \
	"$git_bin" push "$@"
