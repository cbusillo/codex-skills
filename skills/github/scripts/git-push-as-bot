#!/bin/sh
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
git_bin=${GIT_PUSH_AS_BOT_GIT:-git}
gh_bin=${GIT_PUSH_AS_BOT_GH:-gh}
identity_helper=${GIT_PUSH_AS_BOT_IDENTITY_HELPER:-$script_dir/github_identity.py}
python_command=${GIT_PUSH_AS_BOT_PYTHON:-}

# A caller's required automation auth holds even when local.env says otherwise,
# and only the caller can opt in to pushing as their own GitHub user.
caller_require_automation_auth=${GH_WITH_ENV_TOKEN_REQUIRE_AUTOMATION_AUTH:-}
caller_own_user=${GH_WITH_ENV_TOKEN_OWN_USER:-}

# Use the first local.env that exists under CODE_HOME, CODEX_HOME, then
# ~/.code. An explicit CODEX_SKILLS_ENV_FILE always wins, even when missing, so
# tests and isolated callers can load nothing.
if [ -n "${CODEX_SKILLS_ENV_FILE:-}" ]; then
	env_file=$CODEX_SKILLS_ENV_FILE
else
	env_file=
	for env_home in "${CODE_HOME:-}" "${CODEX_HOME:-}" "${HOME:+$HOME/.code}"; do
		if [ -n "$env_home" ] && [ -f "$env_home/local.env" ]; then
			env_file=$env_home/local.env
			break
		fi
	done
fi

# Named remotes must be selected explicitly; never accept a URL as a push target.
selected_remote=origin
if [ "${1:-}" = --remote ]; then
	if [ "$#" -lt 2 ]; then
		echo "error: --remote requires a configured remote name" >&2
		exit 1
	fi
	selected_remote=$2
	case "$selected_remote" in
	'' | -* | *[!a-zA-Z0-9_./-]*)
		echo "error: --remote requires a configured remote name" >&2
		exit 1 ;;
	esac
	shift 2
	set -- "$selected_remote" "$@"
fi
repository_argument=
next_is=
end_options=false
for argument in "$@"; do
	if [ "$next_is" = value ]; then
		next_is=
		continue
	fi
	if [ "$end_options" = true ]; then
		if [ -z "$repository_argument" ]; then repository_argument=$argument; fi
		continue
	fi
	case $argument in
	--remote | --remote=*)
		echo "error: put --remote NAME first, followed by push options and refspecs" >&2
		exit 1 ;;
	--repo | --repo=*)
		echo "error: --repo overrides are unsupported; use --remote NAME" >&2
		exit 1 ;;
	--) end_options=true ;;
	-o | --push-option | --receive-pack | --exec) next_is=value ;;
	-*) ;;
	*) if [ -z "$repository_argument" ]; then repository_argument=$argument; fi ;;
	esac
done
if [ "$repository_argument" != "$selected_remote" ]; then
	echo "error: git-push-as-bot pushes only to origin unless --remote NAME is supplied; got '${repository_argument:-<none>}'" >&2
	echo "hint: run git-push-as-bot [options] origin <refspec>, or git-push-as-bot --remote NAME [options] <refspec>" >&2
	exit 1
fi

if [ -f "$env_file" ]; then
	# Read private configuration without exporting it to git and its hooks.
	# shellcheck disable=SC1090
	. "$env_file"
fi
expected_login=${GH_WITH_ENV_TOKEN_EXPECTED_LOGIN:-${CODEX_AUTOMATION_LOGIN:-}}
if [ -z "$expected_login" ]; then
	echo "error: git-push-as-bot requires the configured automation login; refusing to push" >&2
	echo "hint: set CODEX_AUTOMATION_LOGIN in local.env, as git-commit-as-bot and GitHub writes require" >&2
	exit 1
fi

same_login() {
	[ "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')" ]
}

# get-url expands insteadOf rules. Restore the stored value, not that expansion.
stored_remote_url=$("$git_bin" config --get-all "remote.$selected_remote.url")
case "$stored_remote_url" in
'' | *'
'*)
	echo "error: selected remote must have exactly one stored URL" >&2
	exit 1 ;;
esac
remote_url=$("$git_bin" remote get-url "$selected_remote")
case "$remote_url" in
git@github.com:*)
	repo=${remote_url#git@github.com:}
	;;
ssh://git@github.com/*)
	repo=${remote_url#ssh://git@github.com/}
	;;
https://github.com/*)
	repo=${remote_url#https://github.com/}
	;;
https://*@github.com/*)
	repo=${remote_url#https://*@github.com/}
	;;
*)
	echo "error: selected remote is not a supported github.com URL; refusing to push" >&2
	exit 1
	;;
esac

repo=${repo%.git}
# Only an owner/repository pair can reach authentication or URL rewriting.
case "$repo" in
*/*) owner=${repo%%/*}; repository=${repo#*/} ;;
*) owner=; repository= ;;
esac
case "$owner/$repository" in
/* | */ | *[!a-zA-Z0-9_./-]* | ./* | ../* | */. | */.. | */*/*)
	echo "error: selected remote must name a github.com owner/repository" >&2
	exit 1 ;;
esac
https_url="https://github.com/$repo.git"

# Select credentials the way the GitHub CLI wrapper does, so pushes and API writes
# run as the same automation identity: a configured GitHub App comes first, with
# the installation on the selected repository (each owner installs it separately).
app_variable_count=0
for app_variable in GITHUB_APP_ID GITHUB_APP_INSTALLATION_ID GITHUB_APP_PRIVATE_KEY_PATH; do
	eval "app_variable_value=\${$app_variable:-}"
	if [ -n "$app_variable_value" ]; then
		app_variable_count=$((app_variable_count + 1))
	fi
done

if [ "$app_variable_count" -gt 0 ]; then
	if [ "$app_variable_count" -ne 3 ]; then
		echo "error: incomplete GitHub App configuration; set GITHUB_APP_ID, GITHUB_APP_INSTALLATION_ID, and GITHUB_APP_PRIVATE_KEY_PATH" >&2
		exit 1
	fi
	app_auth_status=0
	if [ -n "$python_command" ]; then
		app_auth_output=$($python_command "$identity_helper" app-auth --repo "$repo" --require-installation) || app_auth_status=$?
	elif command -v uv >/dev/null 2>&1; then
		app_auth_output=$(uv run --no-project --no-config --python 3.12 "$identity_helper" app-auth --repo "$repo" --require-installation) || app_auth_status=$?
	else
		echo "error: git-push-as-bot requires uv or GIT_PUSH_AS_BOT_PYTHON for GitHub App authentication" >&2
		exit 127
	fi
	# github_identity.CONTRIBUTOR_EXIT_STATUS: the App is not installed on
	# the selected repository and its registering account does not own it; with the
	# caller's opt-in the person pushes as their own GitHub user, with the
	# active gh login's token.
	if [ "$app_auth_status" -eq 3 ]; then
		case "$caller_require_automation_auth:${GH_WITH_ENV_TOKEN_REQUIRE_AUTOMATION_AUTH:-}" in
		1:* | true:* | TRUE:* | yes:* | YES:* | *:1 | *:true | *:TRUE | *:yes | *:YES)
			echo "error: $repo is not the automation's repository and automation authentication is required; refusing to push as your own GitHub user" >&2
			exit 1
			;;
		esac
		case "$caller_own_user" in
		1 | true | TRUE | yes | YES) ;;
		*)
			echo "error: the GitHub App is not installed on $repo and another account owns it; pushing there as your own GitHub user needs your Director's approval and GH_WITH_ENV_TOKEN_OWN_USER=1 on this command" >&2
			exit 1
			;;
		esac
		GIT_PUSH_AS_BOT_TOKEN=$(env -u GH_TOKEN -u GITHUB_TOKEN -u CODEX_GITHUB_TOKEN "$gh_bin" auth token 2>/dev/null) || GIT_PUSH_AS_BOT_TOKEN=
		own_login=
		if [ -n "$GIT_PUSH_AS_BOT_TOKEN" ]; then
			own_login=$(GH_TOKEN=$GIT_PUSH_AS_BOT_TOKEN "$gh_bin" api user --jq .login 2>/dev/null) || own_login=
		fi
		if [ -z "$own_login" ]; then
			echo "error: pushing to $repo as your own GitHub user needs an active gh login; run gh auth login" >&2
			exit 1
		fi
		echo "notice: acting as your own GitHub user on $repo; pushing as '$own_login'" >&2
		expected_login=$own_login
	elif [ "$app_auth_status" -ne 0 ]; then
		exit 1
	else
		app_login=$(printf '%s\n' "$app_auth_output" | sed -n '1p')
		GIT_PUSH_AS_BOT_TOKEN=$(printf '%s\n' "$app_auth_output" | sed -n '2p')
		if [ -z "$app_login" ] || [ -z "$GIT_PUSH_AS_BOT_TOKEN" ] || [ "$(printf '%s\n' "$app_auth_output" | sed -n '3p')" != "" ]; then
			echo "error: GitHub App authentication helper returned an invalid response; refusing to push" >&2
			exit 1
		fi
		if ! same_login "$app_login" "$expected_login"; then
			echo "error: push would run as '$app_login', expected '$expected_login'" >&2
			echo "hint: configure CODEX_AUTOMATION_LOGIN for the GitHub App bot identity" >&2
			exit 1
		fi
	fi
elif [ -n "${CODEX_GITHUB_TOKEN:-}" ]; then
	GIT_PUSH_AS_BOT_TOKEN=$CODEX_GITHUB_TOKEN
elif [ -n "${GH_TOKEN:-}" ]; then
	GIT_PUSH_AS_BOT_TOKEN=$GH_TOKEN
elif [ -n "${GITHUB_TOKEN:-}" ]; then
	GIT_PUSH_AS_BOT_TOKEN=$GITHUB_TOKEN
else
	echo "error: no bot GitHub token found; refusing to push as active local git user" >&2
	echo "hint: configure a GitHub App or CODEX_GITHUB_TOKEN for the automation role" >&2
	exit 1
fi

# A user token may be one a person exported in their shell; confirm it belongs
# to the configured automation login before pushing with it.
if [ "$app_variable_count" -eq 0 ]; then
	token_login=$(GH_TOKEN=$GIT_PUSH_AS_BOT_TOKEN "$gh_bin" api user --jq .login 2>/dev/null) || token_login=
	if [ -z "$token_login" ]; then
		echo "error: unable to verify the push token's GitHub account; refusing to push" >&2
		echo "hint: the check uses the GitHub CLI; install it and confirm the token is valid" >&2
		exit 1
	fi
	if ! same_login "$token_login" "$expected_login"; then
		echo "error: push would run as '$token_login', expected '$expected_login'" >&2
		echo "hint: configure CODEX_GITHUB_TOKEN for the automation account" >&2
		exit 1
	fi
fi

askpass_dir=$(mktemp -d "${TMPDIR:-/tmp}/git-push-as-bot.XXXXXX")
askpass=$askpass_dir/askpass

cleanup() {
	"$git_bin" remote set-url "$selected_remote" "$stored_remote_url" >/dev/null 2>&1 || true
	rm -rf "$askpass_dir"
}
trap cleanup EXIT
trap 'exit 130' INT HUP TERM

# Hand the token to git through a file in a private directory, not through
# the environment that git passes on to repository hooks.
chmod 700 "$askpass_dir"
(umask 077 && printf '%s\n' "$GIT_PUSH_AS_BOT_TOKEN" >"$askpass_dir/token")
cat >"$askpass" <<'EOF'
#!/bin/sh
case "$1" in
*Username*) printf '%s\n' x-access-token ;;
*) cat "$(dirname "$0")/token" ;;
esac
EOF
chmod 700 "$askpass"

"$git_bin" remote set-url "$selected_remote" "$https_url"
# A pushurl or an insteadOf rewrite (to SSH, for example) would push with
# credentials other than the automation token.
push_urls=$("$git_bin" remote get-url --push --all "$selected_remote")
if [ "$push_urls" != "$https_url" ]; then
	echo "error: $selected_remote pushes to '$(printf '%s' "$push_urls" | tr '\n' ' ')', not only '$https_url'; refusing to push without the automation token" >&2
	echo "hint: remove remote.$selected_remote.pushurl or the url.*.insteadOf rule that rewrites github.com HTTPS URLs" >&2
	exit 1
fi
# Git asks configured credential helpers before GIT_ASKPASS, and a helper such
# as the GitHub CLI's answers with the active human account; an extraHeader
# (actions/checkout persists one) would authenticate before either. Clear both
# for this URL so the push can only use the automation token.
GIT_ASKPASS=$askpass \
	GIT_TERMINAL_PROMPT=0 \
	env -u CODEX_GITHUB_TOKEN -u GH_TOKEN -u GITHUB_TOKEN -u GIT_PUSH_AS_BOT_TOKEN \
	"$git_bin" -c credential.helper= -c "http.$https_url.extraHeader=" push "$@"
