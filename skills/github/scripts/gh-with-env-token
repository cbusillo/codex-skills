#!/bin/sh
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
classifier=${GH_WITH_ENV_TOKEN_CLASSIFIER:-$script_dir/github_api.py}
identity_helper=${GH_WITH_ENV_TOKEN_IDENTITY_HELPER:-$script_dir/github_identity.py}
python_command=${GH_WITH_ENV_TOKEN_PYTHON:-}

if [ -z "$python_command" ] && ! command -v uv >/dev/null 2>&1; then
	printf 'error: gh-with-env-token requires uv or GH_WITH_ENV_TOKEN_PYTHON\n' >&2
	exit 127
fi

run_python() {
	if [ -n "$python_command" ]; then
		"$python_command" "$@"
	else
		uv run --no-project --no-config --python 3.12 python "$@"
	fi
}

probe_validation_error() {
	run_python "$classifier" terminal-error \
		--operation github.auth.resolve_write_actor \
		--message "$1" \
		--transport gh_cli_wrapper \
		--write-outcome not_started
	exit 2
}

# Use the first local.env that exists under CODE_HOME, CODEX_HOME, then
# ~/.code. An explicit CODEX_SKILLS_ENV_FILE always wins, even when missing, so
# tests and isolated callers can load nothing.
if [ -n "${CODEX_SKILLS_ENV_FILE:-}" ]; then
	env_file=$CODEX_SKILLS_ENV_FILE
else
	env_file=
	for env_home in "${CODE_HOME:-}" "${CODEX_HOME:-}" "${HOME:+$HOME/.code}"; do
		if [ -n "$env_home" ] && [ -f "$env_home/local.env" ]; then
			env_file=$env_home/local.env
			break
		fi
	done
fi
gh_command=${GH_WITH_ENV_TOKEN_GH:-gh}
print_auth_account=0
check_auth=0
write_actor_repository=
require_automation_auth=0
require_automation_auth_from_process=0
stdout_file=$(mktemp)
stderr_file=$(mktemp)
classification_file=$(mktemp)
stdin_file=$(mktemp)
stdin_captured=0

trap 'rm -f "$stdout_file" "$stderr_file" "$classification_file" "$stdin_file"' EXIT INT HUP TERM

case "${GH_WITH_ENV_TOKEN_REQUIRE_AUTOMATION_AUTH:-}" in
1 | true | TRUE | yes | YES)
	require_automation_auth_from_process=1
	;;
esac

# github_identity.OWN_USER_OPT_IN: only the caller's value for this command
# counts, never one from local.env.
own_user_opt_in=0
case "${GH_WITH_ENV_TOKEN_OWN_USER:-}" in
1 | true | TRUE | yes | YES)
	own_user_opt_in=1
	;;
esac
readonly own_user_opt_in

while [ "$#" -gt 0 ]; do
	case "${1:-}" in
	--print-auth-account)
		print_auth_account=1
		shift
		;;
	--check)
		check_auth=1
		shift
		;;
	--write-actor-for)
		if [ "$#" -lt 2 ] || [ -z "${2:-}" ] || [ -n "$write_actor_repository" ]; then
			probe_validation_error "--write-actor-for requires one OWNER/REPO"
		fi
		write_actor_repository=$2
		shift 2
		;;
	--require-automation-auth)
		require_automation_auth=1
		shift
		;;
	*)
		break
		;;
	esac
done

if [ "$check_auth" -eq 1 ] && [ "$#" -ne 0 ]; then
	if [ -n "$write_actor_repository" ]; then
		probe_validation_error "--check does not accept a gh command"
	fi
	echo "error: --check does not accept a gh command" >&2
	exit 2
fi

if [ -f "$env_file" ]; then
	set -a
	# shellcheck disable=SC1090
	. "$env_file"
	set +a
fi

case "${GH_WITH_ENV_TOKEN_REQUIRE_AUTOMATION_AUTH:-}" in
1 | true | TRUE | yes | YES)
	require_automation_auth=1
	;;
esac
if [ "$require_automation_auth_from_process" -eq 1 ]; then
	require_automation_auth=1
fi
readonly require_automation_auth

expected_login=${GH_WITH_ENV_TOKEN_EXPECTED_LOGIN:-${CODEX_AUTOMATION_LOGIN:-}}

run_with_input() {
	if [ "$stdin_captured" -eq 1 ]; then
		"$@" <"$stdin_file"
	else
		"$@"
	fi
}

allows_active_auth_fallback() {
	if [ "$require_automation_auth" -eq 1 ]; then
		return 1
	fi
	case "${GH_WITH_ENV_TOKEN_ALLOW_ACTIVE_AUTH_FALLBACK:-}" in
	1 | true | TRUE | yes | YES)
		return 0
		;;
	*)
		return 1
		;;
	esac
}

is_write_command() {
	while [ "$#" -gt 0 ]; do
		case "${1:-}" in
		-R | --repo | --hostname)
			shift 2 || return 1
			;;
		--repo=* | --hostname=*)
			shift
			;;
		--)
			shift
			break
			;;
		-*)
			shift
			;;
		*)
			break
			;;
		esac
	done

	case "${1:-}" in
	api)
		shift
		while [ "$#" -gt 0 ]; do
			case "$1" in
			--method | -X)
				case "${2:-}" in
				GET | get | HEAD | head)
					return 1
					;;
				*)
					return 0
					;;
				esac
				;;
			--method=* | -X*)
				method=${1#*=}
				if [ "$method" = "$1" ]; then
					method=${1#-X}
				fi
				case "$method" in
				GET | get | HEAD | head)
					return 1
					;;
				*)
					return 0
					;;
				esac
				;;
			-f | -F | --field | --raw-field | --input)
				return 0
				;;
			--field=* | --raw-field=* | --input=*)
				return 0
				;;
			esac
			shift
		done
		return 1
		;;
	issue)
		case "${2:-}" in
		create | edit | close | comment | delete | develop | transfer | pin | unpin | lock | unlock | reopen)
			return 0
			;;
		esac
		;;
	pr)
		case "${2:-}" in
		assign | close | comment | convert-to-draft | create | edit | label | lock | merge | ready | reopen | request-review | review | unlock | update-branch)
			return 0
			;;
		esac
		;;
	run)
		case "${2:-}" in
		approve | cancel | delete | rerun)
			return 0
			;;
		esac
		;;
	workflow)
		case "${2:-}" in
		disable | enable | run)
			return 0
			;;
		esac
		;;
	release)
		case "${2:-}" in
		create | upload | edit | delete | delete-asset)
			return 0
			;;
		esac
		;;
	repo)
		case "${2:-}" in
		create | edit | delete | archive | unarchive | fork | deploy-key | autolink | sync)
			return 0
			;;
		esac
		;;
	project)
		case "${2:-}" in
		create | edit | delete | close | reopen | item-add | item-archive | item-create | item-delete | item-edit)
			return 0
			;;
		esac
		;;
	label)
		case "${2:-}" in
		create | edit | delete | clone)
			return 0
			;;
		esac
		;;
	secret | variable)
		case "${2:-}" in
		set | delete)
			return 0
			;;
		esac
		;;
	gist)
		case "${2:-}" in
		create | edit | delete)
			return 0
			;;
		esac
		;;
	*)
		;;
	esac
	return 1
}

validate_sensitive_read_policy() {
	run_python - "$require_automation_auth" "$@" <<'PY'
import re
import sys
import urllib.parse

require_automation_auth = sys.argv[1] == "1"
arguments = sys.argv[2:]


def decoded_path(value: str) -> str:
    parsed = urllib.parse.urlsplit(value)
    path = parsed.path
    while True:
        decoded = urllib.parse.unquote(path)
        if decoded == path:
            break
        path = decoded
    return f"/{path.lstrip('/')}"


def is_sensitive_endpoint(value: str) -> bool:
    return bool(
        re.fullmatch(
            r"/repos/[^/]+/[^/]+/secret-scanning/alerts(?:/.*)?",
            decoded_path(value),
        )
    )


def reject() -> None:
    print("error: raw repository secret-scanning alert operations are disabled", file=sys.stderr)
    print(
        "hint: use github/scripts/github_read.py --repo OWNER/REPO secret-scanning-status for reads",
        file=sys.stderr,
    )
    raise SystemExit(1)


try:
    api_index = arguments.index("api")
except ValueError:
    raise SystemExit(0)

api_arguments = arguments[api_index + 1 :]
endpoints = [argument for argument in api_arguments if is_sensitive_endpoint(argument)]
if not endpoints:
    raise SystemExit(0)
if len(endpoints) != 1 or not require_automation_auth:
    reject()

endpoint = endpoints[0]
methods = []
headers = []
include_count = 0
endpoint_count = 0
invalid_argument = False
index = 0
while index < len(api_arguments):
    argument = api_arguments[index]
    if argument == endpoint:
        endpoint_count += 1
        index += 1
    elif argument in {"--method", "-X"}:
        if index + 1 >= len(api_arguments):
            invalid_argument = True
            break
        methods.append(api_arguments[index + 1].upper())
        index += 2
    elif argument.startswith("--method="):
        methods.append(argument.split("=", 1)[1].upper())
        index += 1
    elif argument.startswith("-X") and argument != "-X":
        methods.append(argument[2:].upper())
        index += 1
    elif argument in {"--include", "-i"}:
        include_count += 1
        index += 1
    elif argument in {"--header", "-H"}:
        if index + 1 >= len(api_arguments):
            invalid_argument = True
            break
        headers.append(api_arguments[index + 1])
        index += 2
    elif argument.startswith("--header="):
        headers.append(argument.split("=", 1)[1])
        index += 1
    elif argument.startswith("-H") and argument != "-H":
        headers.append(argument[2:])
        index += 1
    else:
        invalid_argument = True
        index += 1

parsed_endpoint = urllib.parse.urlsplit(endpoint)
query = urllib.parse.parse_qs(parsed_endpoint.query, keep_blank_values=True)
header_name, header_separator, header_value = headers[0].partition(":") if len(headers) == 1 else ("", "", "")
allowed_header = (
    header_name.strip().casefold() == "x-github-api-version"
    and header_separator == ":"
    and header_value.strip() == "2022-11-28"
)
allowed_query_keys = {"state", "hide_secret", "per_page", "page"}
per_page_values = query.get("per_page", [])
page_values = query.get("page", [])
valid_per_page = not per_page_values or (
    len(per_page_values) == 1
    and per_page_values[0].isdigit()
    and 1 <= int(per_page_values[0]) <= 100
)
valid_page = not page_values or (
    len(page_values) == 1
    and page_values[0].isdigit()
    and int(page_values[0]) >= 1
)
is_collection = bool(
    re.fullmatch(
        r"/repos/[^/]+/[^/]+/secret-scanning/alerts",
        decoded_path(endpoint),
    )
)
if (
    invalid_argument
    or endpoint_count != 1
    or methods != ["GET"]
    or include_count != 1
    or len(headers) != 1
    or not allowed_header
    or not is_collection
    or parsed_endpoint.fragment
    or not set(query).issubset(allowed_query_keys)
    or query.get("state") != ["open"]
    or query.get("hide_secret") != ["true"]
    or not valid_per_page
    or not valid_page
):
    reject()
PY
}

active_auth_login() {
	env -u GH_TOKEN -u GITHUB_TOKEN -u CODEX_GITHUB_TOKEN "$gh_command" api user --jq .login 2>/dev/null || true
}

verify_bot_login_for_write() {
	if ! is_write_command "$@"; then
		return 0
	fi
	if [ -z "$expected_login" ]; then
		if allows_active_auth_fallback; then
			return 0
		fi
		echo "error: GitHub write requires configured automation login; refusing write" >&2
		if [ "$require_automation_auth" -eq 1 ]; then
			echo "hint: this command requires configured automation authentication" >&2
		else
			echo "hint: set CODEX_AUTOMATION_LOGIN in local.env or explicitly enable active-human fallback" >&2
		fi
		return 1
	fi
	if [ "$auth_source" = github_app ]; then
		if same_login "$app_login" "$expected_login"; then
			return 0
		fi
		echo "error: GitHub write would run as '${app_login:-unknown}', expected '$expected_login'" >&2
		echo "hint: configure CODEX_AUTOMATION_LOGIN for the GitHub App bot identity" >&2
		return 1
	fi
	login_status=0
	run_python "$classifier" --gh "$gh_command" call \
		--method GET \
		--read \
		--operation github.auth.verify_actor \
		/user >"$classification_file" 2>"$stderr_file" || login_status=$?
	if [ "$login_status" -ne 0 ]; then
		print_classified_message
		echo "error: unable to verify the automation GitHub actor; refusing write" >&2
		return "$login_status"
	fi
	login=$(classified_value login "" 2>/dev/null) || login=
	if [ "$login" = "$expected_login" ]; then
		return 0
	fi
	echo "error: GitHub write would run as '${login:-unknown}', expected '$expected_login'" >&2
	echo "hint: configure CODEX_AUTOMATION_LOGIN and CODEX_GITHUB_TOKEN before writing to GitHub" >&2
	return 1
}

refuse_active_auth_fallback() {
	reason=$1
	if allows_active_auth_fallback; then
		return 1
	fi
	echo "error: $reason; refusing to use active local gh auth" >&2
	if [ "$require_automation_auth" -eq 1 ]; then
		echo "hint: this command requires configured automation authentication" >&2
	else
		echo "hint: configure CODEX_AUTOMATION_LOGIN and CODEX_GITHUB_TOKEN, or set GH_WITH_ENV_TOKEN_ALLOW_ACTIVE_AUTH_FALLBACK=1 for an explicitly approved one-off" >&2
	fi
	return 0
}

classify_failure() {
	status_code=$1
	shift
	write_flag=
	if is_write_command "$@"; then
		write_flag=--write
	fi
	run_python "$classifier" --gh "$gh_command" classify-legacy \
		--returncode "$status_code" \
		--stdout-file "$stdout_file" \
		--stderr-file "$stderr_file" \
		--operation github.gh_with_env_token \
		--expected-actor "$expected_login" \
		--transport gh_cli_wrapper \
		--probe-unknown-rate-limit \
		$write_flag >"$classification_file" 2>/dev/null
}

classified_value() {
	field=$1
	default_value=$2
	run_python - "$classification_file" "$field" "$default_value" <<'PY'
import json
import pathlib
import sys

payload = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
field = sys.argv[2]
default = sys.argv[3]
failure = payload.get("failure") or {}
if field == "cause":
    value = payload.get("error_code") or failure.get("cause")
elif field == "message":
    value = failure.get("message") or payload.get("error")
elif field == "login":
    body = payload.get("body") or {}
    value = body.get("login") if isinstance(body, dict) else None
else:
    value = payload.get(field)
print(default if value is None else value)
PY
}

print_classified_message() {
	message=$(classified_value message "GitHub command failed" 2>/dev/null) || message="GitHub command failed"
	printf '%s\n' "$message" >&2
}

retry_with_active_auth() {
	reason=$1
	shift
	print_classified_message
	fallback_login=$(active_auth_login)
	echo "warning: $reason; explicitly authorized active-auth fallback; retrying with the active gh account '${fallback_login:-unknown}'" >&2
	if [ "$print_auth_account" -eq 1 ]; then
		env -u GH_TOKEN -u GITHUB_TOKEN -u CODEX_GITHUB_TOKEN "$gh_command" auth status >&2 || true
	fi
	run_with_input env -u GH_TOKEN -u GITHUB_TOKEN -u CODEX_GITHUB_TOKEN "$gh_command" "$@"
}

print_account() {
	label=$1
	echo "gh auth status ($label):" >&2
	if [ "$auth_source" = github_app ]; then
		printf 'GitHub automation actor: %s (source: %s)\n' "$app_login" "$auth_source" >&2
		return 0
	fi
	"$gh_command" auth status >&2 || true
}

check_account() {
	if [ "$auth_source" = github_app ]; then
		if [ -n "$python_command" ]; then
			checked_login=$($python_command "$identity_helper" app-check)
		else
			checked_login=$(uv run --no-project --no-config --python 3.12 "$identity_helper" app-check)
		fi
		if [ -z "$checked_login" ]; then
			echo "error: GitHub App authentication check returned no actor" >&2
			return 1
		fi
		if [ -n "$expected_login" ] && ! same_login "$checked_login" "$expected_login"; then
			echo "error: GitHub authentication probe reported '$checked_login', expected '$expected_login'" >&2
			return 1
		fi
		printf 'GitHub automation actor: %s (source: %s)\n' "$checked_login" "$auth_source"
		return 0
	fi
	login_status=0
	run_python "$classifier" --gh "$gh_command" call \
		--method GET \
		--read \
		--operation github.auth.check \
		/user >"$classification_file" 2>"$stderr_file" || login_status=$?
	if [ "$login_status" -ne 0 ]; then
		print_classified_message
		return "$login_status"
	fi
	login=$(classified_value login "" 2>/dev/null) || login=
	if [ -z "$login" ]; then
		echo "error: GitHub authentication probe returned no actor" >&2
		return 1
	fi
	if [ -n "$expected_login" ] && [ "$login" != "$expected_login" ]; then
		echo "error: GitHub authentication probe reported '$login', expected '$expected_login'" >&2
		return 1
	fi
	printf 'GitHub automation actor: %s (source: %s)\n' "$login" "$auth_source"
}

same_login() {
	left=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
	right=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')
	[ "$left" = "$right" ]
}

is_actor_probe() {
	[ "${1:-}" = api ] || return 1
	shift
	endpoint_count=0
	method=GET
	actor_probe_include=0
	actor_probe_jq=0
	while [ "$#" -gt 0 ]; do
		case "$1" in
		user | /user)
			endpoint_count=$((endpoint_count + 1))
			shift
			;;
		--method | -X)
			[ "$#" -ge 2 ] || return 1
			method=$2
			shift 2
			;;
		--method=* | -XGET | -Xget)
			case "$1" in --method=*) method=${1#*=} ;; esac
			shift
			;;
		--include | -i)
			actor_probe_include=1
			shift
			;;
		-H | --header)
			[ "$#" -ge 2 ] || return 1
			shift 2
			;;
		--jq)
			[ "$#" -ge 2 ] && [ "$2" = .login ] || return 1
			actor_probe_jq=1
			shift 2
			;;
		-q)
			[ "$#" -ge 2 ] && [ "$2" = .login ] || return 1
			actor_probe_jq=1
			shift 2
			;;
		--jq=.login | -q=.login)
			actor_probe_jq=1
			shift
			;;
		-H* | --header=*) shift ;;
		*) return 1 ;;
		esac
	done
	[ "$endpoint_count" -eq 1 ] && { [ "$method" = GET ] || [ "$method" = get ]; }
}

print_app_actor_probe() {
	if [ "$actor_probe_include" -eq 1 ]; then
		printf 'HTTP/2.0 200\r\ncontent-type: application/json\r\nx-codex-synthetic-response: app-actor\r\n\r\n'
	fi
	if [ "$actor_probe_jq" -eq 1 ]; then
		printf '%s\n' "$app_login"
	else
		printf '{"login":"%s","type":"Bot"}\n' "$app_login"
	fi
}

# The repository a gh command targets, as gh resolves it: an issue or pull
# request URL argument, then the last -R/--repo, then the endpoint of `gh api`
# when it is under repos/, then GH_REPO. Commands that name none (GraphQL by
# node ID, for example) use the configured installation.
target_repository() {
	previous=
	url_repository=
	flag_repository=
	for argument in "$@"; do
		case $previous in
		-R | --repo)
			flag_repository=$(repository_from_reference "$argument")
			previous=
			continue
			;;
		esac
		case $argument in
		https://github.com/*/*/issues/* | https://github.com/*/*/pull/*)
			# Only an operand names the target; the value of a text option,
			# such as a --body that links another issue, does not.
			case $previous in
			-b | --body | -t | --title | --subject | -F | --body-file | -f | --field | --raw-field | -q | --jq | --template | -m | --message)
				previous=$argument
				continue
				;;
			esac
			path=${argument#https://github.com/}
			owner=${path%%/*}
			rest=${path#*/}
			url_repository=$owner/${rest%%/*}
			;;
		--repo=*)
			flag_repository=$(repository_from_reference "${argument#--repo=}")
			;;
		-R?*)
			value=${argument#-R}
			flag_repository=$(repository_from_reference "${value#=}")
			;;
		esac
		previous=$argument
	done
	if [ -n "$url_repository" ]; then
		printf '%s\n' "$url_repository"
		return 0
	fi
	if [ -n "$flag_repository" ]; then
		printf '%s\n' "$flag_repository"
		return 0
	fi
	if [ "${1:-}" = api ]; then
		shift
		api_endpoint "$@" && return 0
	fi
	if [ -n "${GH_REPO:-}" ]; then
		repository_from_reference "$GH_REPO"
	fi
}

# The repository in the endpoint of `gh api`: its first argument that is not an
# option or an option's value.
api_endpoint() {
	skip_value=0
	for argument in "$@"; do
		if [ "$skip_value" -eq 1 ]; then
			skip_value=0
			continue
		fi
		case $argument in
		-X | --method | -f | --raw-field | -F | --field | -H | --header | --input | -q | --jq | -t | --template | -p | --preview | --hostname | --cache)
			skip_value=1
			;;
		-*) ;;
		*)
			path=${argument#/}
			case $path in
			repos/*/*) ;;
			*) return 1 ;;
			esac
			path=${path#repos/}
			owner=${path%%/*}
			rest=${path#*/}
			name=${rest%%[/?#]*}
			case "$owner/$name" in
			*'{'* | *'}'* | /* | */) return 1 ;;
			esac
			printf '%s/%s\n' "$owner" "$name"
			return 0
			;;
		esac
	done
	return 1
}

# gh accepts OWNER/REPO, HOST/OWNER/REPO, and repository URLs.
repository_from_reference() {
	reference=${1%/}
	reference=${reference%.git}
	case $reference in
	git@*:*) reference=${reference#*:} ;;
	esac
	name=${reference##*/}
	rest=${reference%/*}
	owner=${rest##*/}
	printf '%s/%s\n' "$owner" "$name"
}

# Each repository owner installs the App separately; use the installation on
# the repository the command names. A write to a repository without one is
# refused when the account that registered the App owns it; elsewhere the
# helper exits with the contributor status, and the person may act as their
# own GitHub user.
app_auth_for_command() {
	target_repo=$(target_repository "$@")
	require_installation=
	if [ -n "$write_actor_repository" ]; then
		target_repo=$write_actor_repository
		require_installation=1
	elif [ -n "$target_repo" ] && is_write_command "$@"; then
		require_installation=1
	fi
	set -- app-auth
	if [ -n "$target_repo" ]; then
		set -- "$@" --repo "$target_repo"
	fi
	if [ -n "$require_installation" ]; then
		set -- "$@" --require-installation
	fi
	if [ -n "$python_command" ]; then
		$python_command "$identity_helper" "$@"
	else
		uv run --no-project --no-config --python 3.12 "$identity_helper" "$@"
	fi
}

# Resolve the same repository identity as a write, but delegate only a GET
# actor probe. Comment selection must know the writer before reading authors.
if [ -n "$write_actor_repository" ]; then
	case "$write_actor_repository" in
	*[!a-zA-Z0-9_./-]* | */*/* | /* | */ | ./* | ../* | */. | */.. | -*)
		probe_validation_error "--write-actor-for requires OWNER/REPO"
		;;
	*/*) ;;
	*)
		probe_validation_error "--write-actor-for requires OWNER/REPO"
		;;
	esac
	if ! is_actor_probe "$@"; then
		probe_validation_error "--write-actor-for accepts only a GET /user actor probe"
	fi
fi

# Capture stdin only after probe validation, when the command is going to read
# it, so the same body can be replayed to the actor check and to the real call.
# Agent hosts leave stdin open and idle; an invalid probe must fail without
# waiting for an end of file. Commands that read stdin without saying so in
# their arguments still inherit it, just without replay.
reads_stdin=0
for argument in "$@"; do
	case $argument in
	- | @- | *=@- | --with-token) reads_stdin=1 ;;
	esac
done

if [ "$reads_stdin" -eq 1 ] && [ ! -t 0 ]; then
	cat >"$stdin_file"
	stdin_captured=1
fi

# github_identity.CONTRIBUTOR_EXIT_STATUS: the App is not installed on the
# target repository and the account that registered it does not own it.
contributor_exit_status=3

# In a repository someone else owns, a contributor's agent writes as the
# person's own GitHub login only when the caller opted in for this command;
# say so, and never when automation auth is required.
act_as_own_user() {
	own_user_repository=$1
	shift
	if ! validate_sensitive_read_policy "$@"; then
		return 2
	fi
	if [ "$require_automation_auth" -eq 1 ]; then
		echo "error: permission denied: $own_user_repository is not the automation's repository and this command requires configured automation authentication; refusing to act as your own GitHub user" >&2
		return 1
	fi
	if [ "$own_user_opt_in" -ne 1 ]; then
		echo "error: permission denied: the GitHub App is not installed on $own_user_repository and another account owns it; writing there as your own GitHub user needs your Director's approval and GH_WITH_ENV_TOKEN_OWN_USER=1 on this command" >&2
		return 1
	fi
	own_login=$(active_auth_login)
	if [ -z "$own_login" ]; then
		echo "error: acting as your own GitHub user on $own_user_repository needs an active gh login; run gh auth login" >&2
		return 1
	fi
	echo "notice: acting as your own GitHub user on $own_user_repository; using the active gh account '$own_login'" >&2
	if [ "$print_auth_account" -eq 1 ]; then
		echo "gh auth status (your own GitHub user):" >&2
		env -u GH_TOKEN -u GITHUB_TOKEN -u CODEX_GITHUB_TOKEN "$gh_command" auth status >&2 || true
	fi
	run_with_input env -u GH_TOKEN -u GITHUB_TOKEN -u CODEX_GITHUB_TOKEN "$gh_command" "$@"
}

app_variable_count=0
for app_variable in GITHUB_APP_ID GITHUB_APP_INSTALLATION_ID GITHUB_APP_PRIVATE_KEY_PATH; do
	eval "app_variable_value=\${$app_variable:-}"
	if [ -n "$app_variable_value" ]; then
		app_variable_count=$((app_variable_count + 1))
	fi
done
auth_source=user_token
if [ "$app_variable_count" -gt 0 ]; then
	if [ "$app_variable_count" -ne 3 ]; then
		echo "error: incomplete GitHub App configuration; set GITHUB_APP_ID, GITHUB_APP_INSTALLATION_ID, and GITHUB_APP_PRIVATE_KEY_PATH" >&2
		exit 1
	fi
	app_auth_status=0
	app_auth_output=$(app_auth_for_command "$@") || app_auth_status=$?
	if [ "$app_auth_status" -eq "$contributor_exit_status" ]; then
		act_as_own_user "${write_actor_repository:-$(target_repository "$@")}" "$@"
		exit $?
	fi
	if [ "$app_auth_status" -ne 0 ]; then
		exit "$app_auth_status"
	fi
	app_login=$(printf '%s\n' "$app_auth_output" | sed -n '1p')
	GH_TOKEN=$(printf '%s\n' "$app_auth_output" | sed -n '2p')
	if [ -z "$app_login" ] || [ -z "$GH_TOKEN" ] || [ "$(printf '%s\n' "$app_auth_output" | sed -n '3p')" != "" ]; then
		echo "error: GitHub App authentication helper returned an invalid response; refusing GitHub command" >&2
		exit 1
	fi
	auth_source=github_app
elif [ -n "${CODEX_GITHUB_TOKEN:-}" ]; then
	GH_TOKEN=$CODEX_GITHUB_TOKEN
elif [ -z "${GH_TOKEN:-}" ] && [ -n "${GITHUB_TOKEN:-}" ]; then
	GH_TOKEN=$GITHUB_TOKEN
fi

if ! validate_sensitive_read_policy "$@"; then
	exit 2
fi

if [ -z "$expected_login" ] && [ -z "${GH_TOKEN:-}" ] && is_write_command "$@"; then
	if refuse_active_auth_fallback "GitHub write requires configured automation identity"; then
		exit 1
	fi
	fallback_login=$(active_auth_login)
	echo "warning: no automation identity configured; explicitly authorized active-auth fallback; using the active gh account '${fallback_login:-unknown}'" >&2
	if [ "$print_auth_account" -eq 1 ]; then
		echo "gh auth status (active gh auth):" >&2
		env -u GH_TOKEN -u GITHUB_TOKEN -u CODEX_GITHUB_TOKEN "$gh_command" auth status >&2 || true
	fi
	run_with_input env -u GH_TOKEN -u GITHUB_TOKEN -u CODEX_GITHUB_TOKEN "$gh_command" "$@"
	exit $?
fi

if [ -z "${GH_TOKEN:-}" ]; then
	if refuse_active_auth_fallback "no automation gh token found"; then
		exit 1
	fi
	if [ "$check_auth" -eq 1 ]; then
		echo "error: --check needs a configured automation credential; configure a GitHub App or CODEX_GITHUB_TOKEN, or use gh auth status to inspect active local authentication" >&2
		exit 1
	fi
	fallback_login=$(active_auth_login)
	echo "warning: no automation gh token found; explicitly authorized active-auth fallback; using the active gh account '${fallback_login:-unknown}'" >&2
	if [ "$print_auth_account" -eq 1 ]; then
		echo "gh auth status (active gh auth):" >&2
		env -u GH_TOKEN -u GITHUB_TOKEN -u CODEX_GITHUB_TOKEN "$gh_command" auth status >&2 || true
	fi
	run_with_input env -u GH_TOKEN -u GITHUB_TOKEN -u CODEX_GITHUB_TOKEN "$gh_command" "$@"
	exit $?
fi

export GH_TOKEN

if [ "$auth_source" = github_app ] && is_actor_probe "$@"; then
	print_app_actor_probe "$@"
	exit 0
fi

if [ "$check_auth" -eq 1 ]; then
	check_account
	exit $?
fi

if [ "$print_auth_account" -eq 1 ]; then
	print_account "automation token"
fi

verify_bot_login_for_write "$@"

status=0
run_with_input "$gh_command" "$@" >"$stdout_file" 2>"$stderr_file" || status=$?
if [ "$status" -eq 0 ]; then
	cat "$stdout_file"
	exit 0
fi

cause=unknown_error
if classify_failure "$status" "$@"; then
	:
fi
if [ -s "$classification_file" ]; then
	cause=$(classified_value cause unknown_error 2>/dev/null) || cause=unknown_error
fi
write_outcome=$(classified_value write_outcome "" 2>/dev/null) || write_outcome=

if is_write_command "$@" && [ "$write_outcome" = "unknown" ]; then
	cat "$stdout_file"
	print_classified_message
	echo "error: automation GitHub write outcome is unknown; refusing active-auth replay" >&2
	exit "$status"
fi

case "$cause" in
graphql_primary_rate_limited | rest_primary_rate_limited | secondary_rate_limited | rate_limited_unknown_bucket)
	if refuse_active_auth_fallback "automation gh request was rate-limited"; then
		cat "$stdout_file"
		print_classified_message
		exit "$status"
	fi
	retry_with_active_auth "automation gh request was rate-limited" "$@"
	exit $?
	;;
invalid_credentials)
	if refuse_active_auth_fallback "automation gh authentication failed"; then
		cat "$stdout_file"
		print_classified_message
		exit "$status"
	fi
	retry_with_active_auth "automation gh authentication failed" "$@"
	exit $?
	;;
esac

cat "$stdout_file"
print_classified_message
exit "$status"
