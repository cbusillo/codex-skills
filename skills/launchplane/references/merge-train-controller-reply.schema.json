  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The accepted reply of one merge-train controller pass.",
  "properties": {
    "original_trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Original Trace Id"
    },
    "records": {
      "$ref": "#/$defs/MergeTrainControllerReplyRecords"
    },
    "replayed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Replayed"
    },
    "result": {
      "$ref": "#/$defs/MergeTrainControllerReplyResult"
    },
    "status": {
      "const": "accepted",
      "title": "Status",
      "type": "string"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    }
