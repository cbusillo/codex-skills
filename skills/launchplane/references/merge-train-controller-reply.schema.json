        "infrastructure_retry_of": {
          "default": "",
          "maxLength": 256,
          "title": "Infrastructure Retry Of",
          "type": "string"
        },
        "next_actor": {
          "default": "controller",
          "enum": [
            "controller",
            "provider",
            "repository_agent"
          ],
          "title": "Next Actor",
          "type": "string"
        },
        "next_observation": {
          "maxLength": 256,
          "title": "Next Observation",
          "type": "string"
        },
        "observed_at": {
          "maxLength": 64,
          "title": "Observed At",
          "type": "string"
