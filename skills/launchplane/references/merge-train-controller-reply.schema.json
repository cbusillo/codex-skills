        "reason_code": {
          "maxLength": 128,
          "title": "Reason Code",
          "type": "string"
        },
        "reconciliation_required": {
          "default": false,
          "title": "Reconciliation Required",
          "type": "boolean"
        },
        "record_id": {
          "default": "",
          "maxLength": 256,
          "title": "Record Id",
          "type": "string"
        },
        "recovery_kind": {
          "default": "",
          "maxLength": 128,
          "title": "Recovery Kind",
          "type": "string"
        },
        "repository": {
          "maxLength": 256,
          "title": "Repository",
          "type": "string"
