# GitHub automation credentials for scripts/gh-with-env-token.
#
# Copy this file to $CODE_HOME/local.env, $CODEX_HOME/local.env, or
# ~/.code/local.env and set one of these variables. The local.env file is
# machine-local and must not be committed.

# Preferred: a private GitHub App installed on the repositories the automation
# manages. The downloaded private key must have mode 600. Installation tokens
# are minted on demand and cached under the Code home until shortly before expiry.
# GITHUB_APP_ID=123456
# GITHUB_APP_INSTALLATION_ID=12345678
# GITHUB_APP_PRIVATE_KEY_PATH=~/.code/my-automation-app.pem
# Complete App configuration takes precedence over the user tokens below. Install
# the App on every repository this automation must access.

# Required with a non-github.com GH_HOST. Include any enterprise API path.
# GITHUB_APP_API_URL=https://github.example.com/api/v3

# Preferred for GitHub CLI automation.
# GH_TOKEN=github_pat_xxx

# Also accepted; the wrapper exports it as GH_TOKEN for gh.
# GITHUB_TOKEN=github_pat_xxx

# Backward-compatible local alias for existing private setups.
# CODEX_GITHUB_TOKEN=github_pat_xxx

# Portable automation identity. Required for GitHub writes and bot commits.
# For App authentication, use the App's bot login (normally APP-SLUG[bot]).
# CODEX_AUTOMATION_LOGIN=automation-bot
# CODEX_AUTOMATION_EMAIL=automation@example.invalid

# Optional additional owner-controlled automation logins. These accounts are
# also trusted to own managed plan bodies; do not list third-party bots.
# CODEX_AUTOMATION_BOT_LOGINS='legacy-automation-bot'

# Existing per-tool overrides take precedence over the shared automation role.
# GH_WITH_ENV_TOKEN_EXPECTED_LOGIN=automation-bot
# GIT_COMMIT_AS_BOT_NAME='Automation Bot'
# GIT_COMMIT_AS_BOT_EMAIL=automation@example.invalid

# Protected workflow review uses the active local `gh` account as the human
# reviewer. Do not put the human token in this file; authenticate it with
# `gh auth login` and keep it distinct from the automation account above.
